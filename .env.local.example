# Database (MySQL)
DATABASE_URL=mysql://medlygo:medlygo_pass@localhost:3306/medlygo

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AI Agent
ANTHROPIC_API_KEY=your_anthropic_api_key

# Notifications
RESEND_API_KEY=your_resend_api_key
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cron Secret (for cron job authorization)
CRON_SECRET=your_cron_secret

# Docker MySQL (used by docker-compose)
MYSQL_ROOT_PASSWORD=medlygo_root
MYSQL_DATABASE=medlygo
MYSQL_USER=medlygo
MYSQL_PASSWORD=medlygo_pass
